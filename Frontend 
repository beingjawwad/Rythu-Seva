<div id="threejs-container-ANIMATION_4" style="width:100%;height:100%"></div>
<script>
(function() {
  const container = document.getElementById('threejs-container-ANIMATION_4');
  const devicePixelRatio = window.devicePixelRatio || 1;
  const width = container.clientWidth || window.innerWidth;
const height = container.clientHeight || window.innerHeight;

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 1000);
const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
renderer.setSize(width, height);
renderer.setPixelRatio(window.devicePixelRatio);
container.appendChild(renderer.domElement);

// Lighting
const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
scene.add(ambientLight);
const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
directionalLight.position.set(5, 10, 5);
scene.add(directionalLight);

// Create a simple low-poly farm environment
const farmGroup = new THREE.Group();

// Ground
const groundGeo = new THREE.BoxGeometry(20, 0.2, 20);
const groundMat = new THREE.MeshStandardMaterial({ color: 0x3d2b1f });
const ground = new THREE.Mesh(groundGeo, groundMat);
farmGroup.add(ground);

// Field Grid
for (let x = -8; x <= 8; x += 4) {
    for (let z = -8; z <= 8; z += 4) {
        const fieldGeo = new THREE.PlaneGeometry(3.5, 3.5);
        const fieldMat = new THREE.MeshStandardMaterial({ 
            color: (x + z) % 8 === 0 ? 0x2d6a4f : 0x1b4332,
            side: THREE.DoubleSide 
        });
        const field = new THREE.Mesh(fieldGeo, fieldMat);
        field.rotation.x = -Math.PI / 2;
        field.position.set(x, 0.15, z);
        farmGroup.add(field);
        
        // Add tiny 'crops' (cylinders)
        const cropGeo = new THREE.CylinderGeometry(0.05, 0.05, 0.5);
        const cropMat = new THREE.MeshStandardMaterial({ color: 0x95d5b2 });
        for(let i=0; i<3; i++) {
            const crop = new THREE.Mesh(cropGeo, cropMat);
            crop.position.set(x + (Math.random()-0.5)*2, 0.4, z + (Math.random()-0.5)*2);
            farmGroup.add(crop);
        }
    }
}

// Water Tank
const tankGeo = new THREE.CylinderGeometry(1.5, 1.5, 4, 16);
const tankMat = new THREE.MeshStandardMaterial({ color: 0x52b788 });
const tank = new THREE.Mesh(tankGeo, tankMat);
tank.position.set(-12, 2, -12);
// scene.add(tank); // Adjusted positioning for main scene

scene.add(farmGroup);
camera.position.set(15, 15, 15);
camera.lookAt(0, 0, 0);

// Animation
function animate() {
    requestAnimationFrame(animate);
    farmGroup.rotation.y += 0.001;
    renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', () => {
    const w = container.clientWidth || window.innerWidth;
    const h = container.clientHeight || window.innerHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
});
})();
</script>
